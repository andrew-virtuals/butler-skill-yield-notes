{
  "id": "options-lifecycle",
  "version": 12,
  "description": "Watch every option the owner holds, on Derive, Paradex and Rysk and in every wallet, to expiry: a heads-up the day before and the outcome once it settles. One per owner; it only reports.",
  "keywords": [
    "assigned",
    "bought option",
    "butler wallet",
    "call option",
    "cash secured put",
    "covered call",
    "derive",
    "expiry",
    "heads-up",
    "long call",
    "long put",
    "option",
    "paradex",
    "positions",
    "put option",
    "rysk",
    "settlement",
    "yield note"
  ],
  "triggers": [
    "timer"
  ],
  "supersedes": [
    "options-lifecycle@1",
    "options-lifecycle@2",
    "options-lifecycle@3",
    "options-lifecycle@4",
    "options-lifecycle@5",
    "options-lifecycle@6",
    "options-lifecycle@7",
    "options-lifecycle@8",
    "options-lifecycle@9",
    "options-lifecycle@10",
    "options-lifecycle@11"
  ],
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "HEADS_UP_HOURS": {
        "type": "number",
        "minimum": 1,
        "maximum": 168,
        "default": 24,
        "description": "How long before an option's expiry its heads-up is sent. Sent once per option."
      },
      "EXCEPT": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "default": [],
        "description": "The venue's names of options another duty reports on, which this one leaves alone: a sold put filed as options-put-delivery. A name no account holds is ignored."
      }
    }
  },
  "status": {
    "starting": "First check {next}",
    "watching": "{count} open · first {when} · check {next}",
    "settling": "{count} expired, no price yet · check {next}",
    "none": "No options held · next check {next}",
    "unreadable": "Couldn't read the accounts · retry {next}"
  }
}
